# Copy to .dev.vars for local development. .dev.vars is git-ignored.
# Secrets for deployed environments are set with `wrangler secret put`.
APP_ENV=development
PUBLIC_ORIGIN=http://localhost:3000
CONSUMER_TIER_ENABLED=false
EMAIL_FROM=NexPhase Labs <research@nexphaselabs.net>
# Leave unset locally: verification emails are logged to the console instead.
# RESEND_API_KEY=
# With a real key, non-production sends only to exact comma-separated approved test mailboxes.
# TEST_EMAIL_ALLOWLIST=
# Payment rails below are production-only. Staging/development always simulate payment.
# PAYMENT_BANK_INSTRUCTIONS=Bank: Example Bank\nAccount name: 8486 Ventures LLC\nRouting: 000000000\nAccount: 000000000
# BTCPAY_HOST=https://btcpay.example.com
# BTCPAY_STORE_ID=
# BTCPAY_API_KEY=
# BTCPAY_WEBHOOK_SECRET=
