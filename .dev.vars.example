# Copy to .dev.vars for local development. .dev.vars is git-ignored.
# Secrets for deployed environments are set with `wrangler secret put`.
APP_ENV=development
PUBLIC_ORIGIN=http://localhost:3000
CONSUMER_TIER_ENABLED=false
# Guest checkout is independent of optional account registration.
OPEN_CHECKOUT_ENABLED=true
EMAIL_FROM=NexPhase Labs <research@nexphaselabs.net>
# Recommended deployed provider: Google Workspace Gmail API. Use one of the two credential modes below.
# EMAIL_PROVIDER=google_workspace
# Preferred when service-account key creation is blocked: internal OAuth for one mailbox.
# GOOGLE_WORKSPACE_OAUTH_CLIENT_ID=
# GOOGLE_WORKSPACE_OAUTH_CLIENT_SECRET=
# GOOGLE_WORKSPACE_OAUTH_REFRESH_TOKEN=
# GOOGLE_WORKSPACE_SENDER=sam@nexphaselabs.net
# Alternative: delegated service account.
# GOOGLE_WORKSPACE_SERVICE_ACCOUNT_EMAIL=nexphase-mailer@example-project.iam.gserviceaccount.com
# GOOGLE_WORKSPACE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n
# Alternative provider. Leave all providers unset locally to log verification messages.
# EMAIL_PROVIDER=resend
# RESEND_API_KEY=
# With a real key, non-production sends only to exact comma-separated approved test mailboxes.
# TEST_EMAIL_ALLOWLIST=
# Payment rails below are production-only. Staging/development always simulate payment.
# PAYMENT_BANK_INSTRUCTIONS=Bank: Example Bank\nAccount name: 8486 LLC\nRouting: 000000000\nAccount: 000000000
# ZELLE_MODE=disabled
# ZELLE_RECIPIENT_EMAIL=orders@nexphaselabs.net
# ZELLE_RECIPIENT_NAME=Exact name Chase displays to the sender
# ZELLE_QR_IMAGE_PATH=/payments/chase-zelle-qr.png
# ZELLE_GMAIL_MAILBOX=sam@nexphaselabs.net
# ZELLE_CHASE_SENDERS=exact.sender.observed@chase.com
# ZELLE_GMAIL_OAUTH_CLIENT_ID=
# ZELLE_GMAIL_OAUTH_CLIENT_SECRET=
# ZELLE_GMAIL_OAUTH_REFRESH_TOKEN=
# BTCPAY_HOST=https://btcpay.example.com
# BTCPAY_STORE_ID=
# BTCPAY_API_KEY=
# BTCPAY_WEBHOOK_SECRET=
# Commerce readiness. Use a test key locally/staging; never commit credentials.
# INVENTORY_RESERVATION_MINUTES=30
# SHIPPING_PROVIDER=shippo
# SHIPPO_API_KEY=shippo_test_replace_me
# Random secret (32+ characters) appended only to the Shippo webhook URL.
# SHIPPO_WEBHOOK_TOKEN=
# One or more active Shippo carrier-account object IDs. USPS alone is supported.
# Run `npm run shippo:verify` after adding the test key to discover and verify them.
# SHIPPO_CARRIER_ACCOUNTS=shippo_usps_account_object_id
# Sender phone and email are required for USPS label purchase.
# The ship-from location is Lodi, San Joaquin County. It is NOT the registered
# business address, which remains Oakland (lib/entity.ts) -- a parcel leaves from
# one and the entity is registered at the other, and the two must not be merged.
# The first active entry here is also the tax origin (configuredBusinessOrigin),
# which under TAX_PROVIDER=cdtfa is only checked for being in California: the rate
# charged comes from the destination address, not from this one.
# SHIPPING_FROM_JSON={"name":"NexPhase Labs","street1":"2715 W Kettleman Ln Ste 203 #360","city":"Lodi","state":"CA","zip":"95242","country":"US","phone":"REPLACE","email":"orders@nexphaselabs.net","is_residential":false}
# For multiple locations, replace SHIPPING_FROM_JSON with this protected array. The first active entry is the checkout default.
# SHIPPO_ORIGINS_JSON=[{"id":"lodi-1","label":"Lodi","active":true,"address":{"name":"NexPhase Labs","street1":"2715 W Kettleman Ln Ste 203 #360","city":"Lodi","state":"CA","zip":"95242","country":"US","phone":"REPLACE","email":"orders@nexphaselabs.net","is_residential":false}}]
# Standard packed parcel used until SKU-specific packing profiles are approved.
# SHIPPING_DEFAULT_PARCEL_JSON={"length":8,"width":6,"height":4,"baseWeight":0.4,"perPackWeight":0.1}
# SHIPPING_ALLOWED_SERVICES=usps_ground_advantage,usps_priority
# CHECKOUT_QUOTES_REQUIRED=true
# TAX_PROVIDER=taxjar
# TAXJAR_API_KEY=
# TAXJAR_SANDBOX=true
# Non-production UI rehearsal only; never allowed in production.
# SHIPPING_SIMULATION_ENABLED=true
# TAX_PROVIDER=simulated
# TAX_SIMULATED_RATE_BPS=825
# Production must also explicitly set LIVE_SHIPPING_ENABLED=true after approval.
# LIVE_SHIPPING_ENABLED=false
# Read-only feedback archive used by an approved ChatGPT Action. Generate a random value of at least 32 characters.
# CHATGPT_FEEDBACK_READ_TOKEN=
