{
  // Cloudflare Workers configuration for nexphaselabs.net.
  //
  // Two environments:
  //   - top level  = production  (`npx wrangler deploy`)
  //   - env.staging              (`npx wrangler deploy --env staging`)
  //
  // Each environment has its own D1 database and R2 bucket so staging can be
  // exercised freely without touching production lot records or documents.
  // Secrets are never written here; see docs/DEPLOY.md.
  "$schema": "node_modules/wrangler/config-schema.json",
  "account_id": "3d429c7b2020e96fe10a1588f1fb3662",
  "name": "nexphaselabs",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": ["nodejs_compat"],
  "main": "worker.ts",
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS",
  },
  "observability": { "enabled": true },
  "durable_objects": {
    "bindings": [{ "name": "FEEDBACK_ROOMS", "class_name": "FeedbackRoom" }],
  },
  "migrations": [
    { "tag": "v1_feedback_rooms", "new_sqlite_classes": ["FeedbackRoom"] },
  ],
  "triggers": { "crons": ["*/5 * * * *"] },
  "vars": {
    "APP_ENV": "production",
    "PUBLIC_ORIGIN": "https://nexphaselabs.net",
    "RESEARCHER_TIER_ENABLED": "false",
    "ZELLE_RECIPIENT_EMAIL": "orders@nexphaselabs.net",
    "ZELLE_RECIPIENT_NAME": "8486 llc",
    "ZELLE_MODE": "manual",
    "EMAIL_FROM": "NexPhase Labs <research@nexphaselabs.net>",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nexphase-labs",
      "database_id": "70e80fa9-cd27-4fd7-b0ee-1fea56c5778d",
      "migrations_dir": "drizzle",
    },
  ],
  "r2_buckets": [
    {
      "binding": "DOCS",
      "bucket_name": "nexphase-documents",
    },
  ],
  "env": {
    "staging": {
      "name": "nexphaselabs-staging",
      // Workers Assets serves static files ahead of the worker, so without this the
      // staging password gate would cover the pages and APIs but not the bundles,
      // product images or the client manifest. Staging runs the worker first for
      // everything; worker.ts hands real assets back to the asset store. Production
      // deliberately does NOT set this — there the files are public anyway and every
      // asset should be served without a worker invocation.
      "assets": {
        "directory": "dist/client",
        "not_found_handling": "none",
        "binding": "ASSETS",
        "run_worker_first": true,
      },
      "durable_objects": {
        "bindings": [
          { "name": "FEEDBACK_ROOMS", "class_name": "FeedbackRoom" },
        ],
      },
      "migrations": [
        { "tag": "v1_feedback_rooms", "new_sqlite_classes": ["FeedbackRoom"] },
      ],
      "triggers": { "crons": ["*/5 * * * *"] },
      "vars": {
        "APP_ENV": "staging",
        "OPEN_CHECKOUT_ENABLED": "true",
        // Public staging, by the owner's decision of 14 September 2026: storefront pages are open to
        // anonymous visitors and carry noindex, while staff pages and private APIs keep their own logins.
        // Declared here and never as a Worker secret, so the choice is reviewed and the deploy's last step
        // (scripts/staging-access-check.mjs) knows which boundary to prove. Without this line staging is
        // closed again: it needs STAGING_ACCESS_PASSWORD, and refuses everyone until that is set.
        "STAGING_ACCESS_OPEN": "true",
        // Real staging origin on the account's workers.dev subdomain. Keep the STAGING_URL repository
        // variable identical; staging email links and payment return URLs are built from this.
        "PUBLIC_ORIGIN": "https://nexphaselabs-staging.ammre.workers.dev",
        "RESEARCHER_TIER_ENABLED": "true",
        "ZELLE_RECIPIENT_EMAIL": "orders@nexphaselabs.net",
        "ZELLE_RECIPIENT_NAME": "8486 llc",
        // Manual mode enables a safe Zelle simulation here. The application replaces these real
        // enrollment values with unmistakable fake details and never contacts a payment provider.
        "ZELLE_MODE": "manual",
        // Shippo test mode obtains real carrier test rates without buying live postage.
        // The API key and private ship-from contact are protected Worker secrets.
        "SHIPPING_PROVIDER": "shippo",
        "SHIPPO_CARRIER_ACCOUNTS": "256b9f9e2b784b0fb2ee5971d31e3c5e",
        "SHIPPING_DEFAULT_PARCEL_JSON": "{\"length\":8,\"width\":6,\"height\":4,\"baseWeight\":0.4,\"perPackWeight\":0.1}",
        "SHIPPING_ALLOWED_SERVICES": "usps_ground_advantage,usps_priority",
        "CHECKOUT_QUOTES_REQUIRED": "true",
        "INVENTORY_RESERVATION_MINUTES": "30",
        "TAX_PROVIDER": "simulated",
        "TAX_SIMULATED_RATE_BPS": "825",
        "EMAIL_FROM": "NexPhase Labs <research@nexphaselabs.net>",
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "nexphase-labs-staging",
          "database_id": "d24c1b97-1517-4ac4-a019-bed2a2a39c2b",
          "migrations_dir": "drizzle",
        },
      ],
      "r2_buckets": [
        {
          "binding": "DOCS",
          "bucket_name": "nexphase-documents-staging",
        },
      ],
    },
  },
}
